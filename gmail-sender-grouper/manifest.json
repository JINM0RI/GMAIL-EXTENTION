{
  "manifest_version": 3,
  "name": "Gmail Sender Grouper",
  "version": "2.0.0",
  "description": "Groups Gmail inbox emails by sender and shows results in a floating UI inside Gmail.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "libs/jquery.min.js",
        "libs/gmail.js",
        "gmailLoader.js",
        "senderExtractor.js",
        "groupEngine.js",
        "content.js",
        "uiRenderer.js",
        "floatingButton.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
