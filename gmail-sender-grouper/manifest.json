{
  "manifest_version": 3,
  "name": "Gmail Sender Grouper",
  "version": "1.0.0",
  "description": "Groups visible Gmail inbox emails by sender with collapsible sections and live stats.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "action": {
    "default_title": "Gmail Sender Grouper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "gmailLoader.js",
        "groupingEngine.js",
        "uiRenderer.js",
        "search.js",
        "statsPanel.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
