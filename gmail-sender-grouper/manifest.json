{
  "manifest_version": 3,
  "name": "Gmail Sender Grouper",
  "version": "2.0.0",
  "description": "Groups Gmail inbox emails by sender and shows results in the extension popup.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "action": {
    "default_title": "Sender Grouper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "libs/jquery.min.js",
        "libs/gmail.js",
        "gmailLoader.js",
        "senderExtractor.js",
        "groupEngine.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
